# Selkies & Pelorus Environment Configuration for Wayland on LXC.

# --- Pixelflux & Wayland ---
# Enables in-process Wayland compositor (Smithay) on wayland-1 (requires CPU with AVX)
PIXELFLUX_WAYLAND=true
# Pixelflux Computer Use (CU) API port (required by Pelorus for input injection and screenshots)
PIXELFLUX_CU=5000
SELKIES_COMPUTER_USE_BIND=5000
WAYLAND_DISPLAY=wayland-1
SELKIES_APP_WAYLAND_DISPLAY=wayland-0
DISABLE_ZINK=false

# --- Selkies Streaming ---
# Selkies WebSocket listening port (must match Nginx CWS proxy port: 8082)
CUSTOM_WS_PORT=8082
SELKIES_PORT=8082
SELKIES_ENCODER=h264enc
SELKIES_FRAMERATE=60
SELKIES_ENABLE_RESIZE=true
SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so
SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so
SELKIES_ALLOWED_ORIGINS="*"
SELKIES_ENABLE_BASIC_AUTH=false
TITLE=Debian-13
TZ=Europe/Warsaw
START_DOCKER=false
LSIO_FIRST_PARTY=true
NVIDIA_DRIVER_CAPABILITIES=all
DISPLAY_SIZEW=1024
DISPLAY_SIZEH=768
DISPLAY_REFRESH=60
DISPLAY_DPI=96
DISPLAY_CDEPTH=24
GST_DEBUG=*:1

# --- Pelorus (AI Navigator) ---
# Enables Pelorus AI navigation agent and UI
PELORUS=true
PELORUS_PORT=5100
# FastAPI root path for Nginx reverse proxy under /pelorus/
ROOT_PATH=/pelorus
PELORUS_ENVIRONMENT="KDE Plasma Desktop (Linux)"
# Default LLM provider configuration for /config/agent/config.toml
PELORUS_PROVIDER=ollama
PELORUS_ENDPOINT=http://localhost:11434
PELORUS_MODEL=gemma4:12b
PELORUS_API_KEY=""

# --- Desktop Environment & Compositor ---
# Desktop Environment: kde (default, KDE Plasma 6 + KWin) or xfce (XFCE 4.20 + Labwc)
DESKTOP_ENVIRONMENT=kde
# Compositor backend: Q = software (QPainter for KWin, pixman for Labwc; recommended for LXC without GPU)
# Set KWIN_COMPOSE=O2 if GPU passthrough is configured in LXC
# Note for KDE: remove ~/.config/kwinrc after changing and restart desktop service.
KWIN_COMPOSE=Q
MOZ_ENABLE_WAYLAND=1
KWIN_WAYLAND_NO_PERMISSION_CHECKS=1
